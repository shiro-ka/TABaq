{
    "manifest_version": 2,
    "name": "TABaq",
    "version": "2.0",
    "description": "新しいタブを水溶 .oO°",
    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },
    "permissions": [
        "bookmarks",
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "tabaq@lab49",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "update_url": "https://github.com/shiro-ka/TABaq/releases/download/dev/updates.json"
        }
    },
    "browser_action": {
        "default_icon": {
            "48": "icons/icon-48.png",
            "96": "icons/icon-96.png"
        },
        "default_title": "TABaq - ブックマークを開く"
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "web_accessible_resources": [
        "newtab.html",
        "newtab.css",
        "newtab.js",
        "icons/*"
    ]
}
